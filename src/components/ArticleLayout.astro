---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageLightbox from './ImageLightbox.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { formatArticleDate, visibleEditorialUpdate } from '../lib/article-dates';
import { resolveMetaDescription } from '../lib/seo';

interface Props {
  entry: CollectionEntry<'entries'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const title = d.meta_title || d.title;
const description = resolveMetaDescription({
  meta_description: d.meta_description,
  excerpt: d.excerpt,
  content_plaintext: d.content_plaintext,
});
const ogTitle = d.og_title || title;
const ogDescription = d.og_description || description;

function absImage(src: string | undefined) {
  if (!src) return undefined;
  if (src.startsWith('http')) return src;
  return new URL(src, d.canonical_url).href;
}

const ogImage = absImage(d.og_image || d.feature_image);
const twitterTitle = d.twitter_title || ogTitle;
const twitterDescription = d.twitter_description || ogDescription;
const twitterImage = absImage(d.twitter_image || d.og_image || d.feature_image);

const publishedAt = d.published_at;
const editorialUpdatedAt = visibleEditorialUpdate(
  publishedAt,
  d.editorial_updated_at,
);
const publishedDateStr = publishedAt ? formatArticleDate(publishedAt) : null;
const updatedDateStr = editorialUpdatedAt
  ? formatArticleDate(editorialUpdatedAt)
  : null;
const articleStructuredData =
  d.type === 'post' && publishedAt
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: d.title,
        url: d.canonical_url,
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': d.canonical_url,
        },
        datePublished: publishedAt.toISOString(),
        ...(editorialUpdatedAt
          ? { dateModified: editorialUpdatedAt.toISOString() }
          : {}),
        ...(ogImage ? { image: ogImage } : {}),
        author: {
          '@type': 'Person',
          name: 'Sergio Cava',
          url: 'https://www.astrocava.com/author/sergio/',
        },
        inLanguage: 'es',
      }
    : undefined;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={d.canonical_url}
  ogImage={ogImage}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
  articlePublishedTime={d.type === 'post' ? publishedAt?.toISOString() : undefined}
  articleModifiedTime={
    d.type === 'post' ? editorialUpdatedAt?.toISOString() : undefined
  }
  structuredData={articleStructuredData}
>
  <article class="prose">
    <header class="article-header">
      <h1>{d.title}</h1>
      {
        publishedDateStr && publishedAt && (
          <p class="article-meta">
            <span>
              Publicado:{' '}
              <time datetime={publishedAt.toISOString()}>{publishedDateStr}</time>
            </span>
            {updatedDateStr && editorialUpdatedAt && (
              <>
                <span aria-hidden="true"> · </span>
                <span>
                  Actualizado:{' '}
                  <time datetime={editorialUpdatedAt.toISOString()}>
                    {updatedDateStr}
                  </time>
                </span>
              </>
            )}
          </p>
        )
      }
      {
        d.feature_image && (
          <figure class="feature-image">
            <img
              src={d.feature_image}
              alt={d.feature_image_alt || d.title}
              loading="eager"
            />
            {
              (d.feature_image_caption ||
                d.feature_image_credit ||
                d.feature_image_license) && (
                <figcaption>
                  {d.feature_image_caption && (
                    <span class="feature-image-caption">{d.feature_image_caption}</span>
                  )}
                  {(d.feature_image_credit || d.feature_image_license) && (
                    <small class="feature-image-attribution">
                      {d.feature_image_credit && (
                        <>
                          {'Crédito: '}
                          {d.feature_image_credit_url ? (
                            <a href={d.feature_image_credit_url} rel="noreferrer">
                              {d.feature_image_credit}
                            </a>
                          ) : (
                            d.feature_image_credit
                          )}
                          {'.'}
                        </>
                      )}
                      {d.feature_image_license && (
                        <>
                          {d.feature_image_credit ? ' Licencia: ' : 'Licencia: '}
                          {d.feature_image_license_url ? (
                            <a href={d.feature_image_license_url} rel="noreferrer">
                              {d.feature_image_license}
                            </a>
                          ) : (
                            d.feature_image_license
                          )}
                          {'.'}
                        </>
                      )}
                    </small>
                  )}
                </figcaption>
              )
            }
          </figure>
        )
      }
    </header>
    <Content />
  </article>
  <ImageLightbox />
</BaseLayout>

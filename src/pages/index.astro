---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import HomeShowcases from '../components/HomeShowcases.astro';
import SearchBox from '../components/SearchBox.astro';
import { getPublishedEntries } from '../lib/entries';
import { getRecentHomeEntries, resolveHomeSections } from '../lib/home';

const entries = await getPublishedEntries();
const sections = resolveHomeSections(entries);
const recentEntries = getRecentHomeEntries(entries);
const canonicalUrl = 'https://www.astrocava.com/';
---

<BaseLayout
  title="Astrocava"
  description="Astronomía, astrofotografía, observación y arqueoastronomía."
  canonicalUrl={canonicalUrl}
  mainClass="site-main--home"
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-content">
        <p class="home-hero-kicker">Astrocava · Cuaderno del cielo</p>
        <h1 id="home-title">
          Esto va de Astronomía: Observación visual, Astrofotografía y un poco de Arqueoastronomía
        </h1>
        <p class="home-hero-summary">
          Imágenes, técnicas y relatos para observar, entender e inmortalizar nuestro Sistema Solar y los objetos de cielo profundo, además de explorar la huella que los astros nos han dejado en la historia.
        </p>
        <SearchBox variant="hero" idPrefix="home-search" />
        <nav class="home-area-links" aria-label="Explorar por áreas">
          {
            sections.map((section) => (
              <a href={`#area-${section.id}`}>{section.shortLabel}</a>
            ))
          }
        </nav>
      </div>
    </section>

    <HomeShowcases sections={sections} />

    <section class="home-recent" aria-labelledby="home-recent-title">
      <header class="home-recent-heading">
        <p class="home-section-kicker">Un punto de partida</p>
        <h2 id="home-recent-title">Tres lecturas recientes de la selección</h2>
      </header>
      <EntryList entries={recentEntries} />
    </section>
  </div>
</BaseLayout>
